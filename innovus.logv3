[05/13 23:46:42     31s] -start_time_shift <string>        # Specifies to shift the start time of the
[05/13 23:46:42     31s]                                   # specified activity files. (string, optional)
[05/13 23:46:42     31s] -weight <string>                  # Specifies the weight number of the TCF
[05/13 23:46:42     31s]                                   # file. Default : 1.0 (string, optional)
