[DEFAULT]
label = 

[Path]
home = ./../
library = %(home)slib/
flp = %(home)sflp_files/
ptrace = %(home)sptrace_files/

[Simulation]
steady_state = True
steady_state_solver = Solver
transient = False
step_size = 16.098884us
total_simualation_time = 1014.22969us
total_simulation_time = 1014.22969us
ptrace_step_size = 16.098884us
temperature_dependent = False
convergence = 0.1
layer = 1
temperature_dependent_library = TemperatureDependent.py
number_of_core = 1
init_file = False

[Solver]
name = SuperLU
wrapper = SuperLU_steady.py
ll_steady_solver = KLU
ll_transient_solver = TRAP

[Grid]
grid_mode = max
type = Uniform
granularity = Grid
rows = 64
cols = 64

[VirtualNodes]
center_center = 0.5
bottom_center = 1

[NoPackage]
LateralHeatFlow = True
VerticalHeatFlow = False
library_name = NoPackage_sec
library = Solid.py
virtual_node = bottom_center
transient = False
mode = single

[NoPackage_sec]
properties = htc, thickness (m), thermalresistivity ((m-k)/w), specificheatcapacity (j/m^3k)

[Si]
library_name = Solid
library = Solid.py
transient = True
virtual_node = bottom_center
mode = single

[Solid]
properties = thermalresistivity ((m-k)/w), specificheatcapacity (j/m^3k)
